{
  "name": "iritoken",
  "version": "0.4.0",
  "description": "Deterministic, provider-agnostic context optimization toolkit with optional budgeting, retrieval, caching, routing, and evaluation.",
  "keywords": [
    "tokens",
    "llm",
    "context",
    "tokenizer",
    "optimization",
    "context-window",
    "semantic-cache",
    "model-routing",
    "retrieval",
    "llm-observability",
    "logs",
    "stack-trace",
    "test-output",
    "ansi",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "dan",
  "homepage": "https://github.com/lelianto/iritoken",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelianto/iritoken.git"
  },
  "bugs": {
    "url": "https://github.com/lelianto/iritoken/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js"
    },
    "./integrations/messages": {
      "types": "./dist/integrations/messages.d.ts",
      "import": "./dist/integrations/messages.js"
    },
    "./integrations/commands": {
      "types": "./dist/integrations/commands.d.ts",
      "import": "./dist/integrations/commands.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation/quality-gate.d.ts",
      "import": "./dist/evaluation/quality-gate.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "iritoken": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "assets/logo.svg",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "test:security": "npm run build && tsx --test test/security.test.ts test/context-security.test.ts test/ansi.test.ts test/cli.test.ts test/enhancements.test.ts",
    "test:real-cases": "npm run benchmark:corpus && npm run benchmark:detection && npm run benchmark:semantic",
    "benchmark": "node --import tsx benchmarks/runners/offline.ts",
    "benchmark:compression": "tsx benchmark/run.ts",
    "benchmark:quality": "tsx benchmark/quality.ts",
    "benchmark:perf": "tsx benchmark/performance.ts",
    "benchmark:context-perf": "tsx benchmark/context-performance.ts",
    "benchmark:corpus": "tsx benchmark/corpus-regression.ts",
    "benchmark:detection": "tsx benchmark/detection-quality.ts",
    "benchmark:semantic": "tsx benchmark/semantic-quality.ts",
    "benchmark:stream": "tsx benchmark/stream-performance.ts",
    "benchmark:groq": "tsx benchmark/groq-live.ts",
    "benchmark:deepseek": "tsx benchmark/deepseek-live.ts",
    "benchmark:deepseek:frontier": "node --import tsx benchmarks/runners/deepseek.ts",
    "benchmark:frontier:report": "node --import tsx benchmarks/results/report.ts",
    "benchmark:deepseek:context": "tsx benchmark/deepseek-context-engine.ts",
    "benchmark:deepseek:campaign": "tsx benchmark/deepseek-context-campaign.ts",
    "benchmark:verify": "npm run benchmark:compression -- safe && npm run benchmark:compression -- balanced && npm run benchmark:quality && npm run benchmark:corpus && npm run benchmark:detection && npm run benchmark:semantic && npm run benchmark:perf && npm run benchmark:context-perf && npm run benchmark:stream && npm run report",
    "test:benchmark": "node --import tsx --test benchmarks/evaluators/*.test.ts benchmarks/runners/*.test.ts",
    "pack:smoke": "npm run build && node scripts/pack-smoke.mjs",
    "release:integrity": "node scripts/release-integrity.mjs",
    "report": "tsx benchmark/report.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run test:security && npm run test:real-cases && npm run pack:smoke",
    "release:check": "npm run release:integrity && npm run prepublishOnly && npm pack --dry-run --ignore-scripts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  }
}
